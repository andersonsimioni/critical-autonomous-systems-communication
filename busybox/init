#!/bin/sh
# init mínimo para debug

echo "[init] Subiu o script init!"

# Monta os sistemas de arquivos básicos
mount -t proc none /proc
mount -t sysfs none /sys
mount -t devtmpfs none /dev

# Mostra o que tem disponível
echo "[init] Conteúdo de /:"
ls -l /

echo "[init] Conteúdo de /bin:"
ls -l /bin

# Abre um shell interativo do busybox
exec /bin/sh




